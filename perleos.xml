  SPDX-License-Identifier: Apache-2.0

  PerleOS repositories added on top of the LineageOS manifest
  (repo init -u https://github.com/LineageOS/android -b lineage-21.0).
  Upstream projects are used unchanged and are not listed here, except the
  forks below.
-->
<manifest>

  <!-- Absolute URL: the upstream "github" remote is relative to the LineageOS manifest URL. -->
  <remote name="perleos"
          fetch="https://github.com/PerleOS"
          revision="refs/heads/lineage-21.0" />

  <!--
    Forks of LineageOS projects. The stock 4.14 kernel lacks BPF object names
    and per-file bpffs labels; these forks make the BPF loaders and
    ClatCoordinator work without them. Rebased on each LineageOS security merge.
  -->
  <remove-project name="LineageOS/android_packages_modules_Connectivity" />
  <project path="packages/modules/Connectivity" name="android_packages_modules_Connectivity" remote="perleos" groups="pdk-cw-fs,pdk-fs" />
  <remove-project name="LineageOS/android_system_bpf" />
  <project path="system/bpf" name="android_system_bpf" remote="perleos" groups="pdk" />

  <!-- Device trees -->
  <project path="device/lenovo/pearl-common" name="android_device_lenovo_pearl-common" remote="perleos" />
  <project path="device/lenovo/j706f" name="android_device_lenovo_j706f" remote="perleos" />

  <!-- Product: branding overlay on top of vendor/lineage, microG prebuilts -->
  <project path="vendor/perleos" name="android_vendor_perleos" remote="perleos" />
  <project path="vendor/microg" name="android_vendor_microg" remote="perleos" />

  <!--
    Not listed yet:
    - kernel/lenovo/sm6150 (android_kernel_lenovo_sm6150): phase 1 boots the stock prebuilt
      kernel; added when the inline-kernel phase starts.
    - vendor/lenovo/pearl-common, vendor/lenovo/j706f (proprietary_vendor_lenovo_*): private
      blob repositories, kept in a separate local manifest on machines that have access,
      through the upstream "private" remote (ssh://git@github.com).
  -->

</manifest>

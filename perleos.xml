<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-FileCopyrightText: The PerleOS Project
  SPDX-License-Identifier: Apache-2.0

  PerleOS repositories added on top of the LineageOS manifest
  (repo init -u https://github.com/LineageOS/android -b lineage-24.0).
  Upstream projects are used unchanged and are not listed here. The forks of
  lineage-21.0 are added back as they are ported.
-->
<manifest>

  <!-- Absolute URL: the upstream "github" remote is relative to the LineageOS manifest URL. -->
  <remote name="perleos"
          fetch="https://github.com/PerleOS"
          revision="refs/heads/lineage-24.0" />

  <!-- GNU binutils 2.27 for the kernel, built as the stock kernel so that the stock vendor
       modules keep loading; the lineage-24.0 manifest no longer has it -->
  <project path="prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9"
           name="LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9"
           remote="github" revision="refs/heads/lineage-19.1" clone-depth="1" groups="pdk,linux,arm" />

  <!-- Device trees -->
  <project path="device/lenovo/pearl-common" name="android_device_lenovo_pearl-common" remote="perleos" />
  <project path="device/lenovo/j706f" name="android_device_lenovo_j706f" remote="perleos" />

  <!-- Kernel (fork of HK4567/android_kernel_lenovo_sm7150) -->
  <project path="kernel/lenovo/sm6150" name="android_kernel_lenovo_sm6150" remote="perleos" />

  <!-- Product configuration and microG -->
  <project path="vendor/perleos" name="android_vendor_perleos" remote="perleos" />
  <project path="vendor/microg" name="android_vendor_microg" remote="perleos" />

  <!-- Proprietary files, extracted unedited from the stock S620150 ROW firmware by the
       device tree's extract-files.py; hosted outside the PerleOS organization. -->
  <remote name="packrats"
          fetch="https://github.com/ThePackrats"
          revision="refs/heads/lineage-24.0" />
  <project path="vendor/lenovo/pearl-common" name="proprietary_vendor_lenovo_pearl-common" remote="packrats" />

</manifest>

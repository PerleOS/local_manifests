  SPDX-License-Identifier: Apache-2.0

  PerleOS repositories added on top of the LineageOS manifest
  (repo init -u https://github.com/LineageOS/android -b lineage-24.0).
  Upstream projects are used unchanged and are not listed here, except the
  forks below.
-->
<manifest>

  <!-- Absolute URL: the upstream "github" remote is relative to the LineageOS manifest URL. -->
  <remote name="perleos"
          fetch="https://github.com/PerleOS"
          revision="refs/heads/lineage-24.0" />

  <!-- Fork of frameworks/base: LineageOS's restricted microG signature spoof on user builds,
       and a fix for a SystemUI crash when a desktop windowing desk is already removed. -->
  <remove-project name="LineageOS/android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base" remote="perleos" groups="pdk-cw-fs,pdk-fs,sysui-studio" />

  <!-- Fork of packages/modules/Bluetooth: legacy LE Create Connection on controllers without
       LE Extended Advertising (WCN3990 rejects the extended command it advertises). -->
  <remove-project name="LineageOS/android_packages_modules_Bluetooth" />
  <project path="packages/modules/Bluetooth" name="android_packages_modules_Bluetooth" remote="perleos" groups="pdk" />

  <!-- Fork of packages/apps/Aperture: stays open when the camera access toggle blocks the
       camera, and binds it again once unblocked (the stock camera HAL has no camera mute). -->
  <remove-project name="LineageOS/android_packages_apps_Aperture" />
  <project path="packages/apps/Aperture" name="android_packages_apps_Aperture" remote="perleos" />

  <!-- GNU binutils 2.27 for the kernel, as used for the stock kernel; the lineage-24.0
       manifest no longer has it -->
  <project path="prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9"
           name="LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9"
           remote="github" revision="refs/heads/lineage-19.1" clone-depth="1" groups="pdk,linux,arm" />

  <!-- Device trees -->
  <project path="device/lenovo/pearl-common" name="android_device_lenovo_pearl-common" remote="perleos" />
  <project path="device/lenovo/j706f" name="android_device_lenovo_j706f" remote="perleos" />

  <!-- Kernel (fork of HK4567/android_kernel_lenovo_sm7150) -->
  <project path="kernel/lenovo/sm6150" name="android_kernel_lenovo_sm6150" remote="perleos" />

  <!-- Product configuration and microG -->
  <project path="vendor/perleos" name="android_vendor_perleos" remote="perleos" />
  <project path="vendor/microg" name="android_vendor_microg" remote="perleos" />

  <!-- Proprietary files, extracted from the stock S620150 ROW firmware by the device tree's
       extract-files.py (with its fixups); hosted outside the PerleOS organization. -->
  <remote name="packrats"
          fetch="https://github.com/ThePackrats"
          revision="refs/heads/lineage-24.0" />
  <project path="vendor/lenovo/pearl-common" name="proprietary_vendor_lenovo_pearl-common" remote="packrats" />

</manifest>
